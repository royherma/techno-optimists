# Copy to .env (local) / .dev.vars (worker). Never commit the filled version.

# Comma-separated admin addresses, e.g. you@example.com,other@example.com.
# Unset means nobody is an admin, which is the right default for a clone - the
# site works, the import route just stays closed. On a deployed Worker this is a
# secret, not a var: `wrangler secret put ADMIN_EMAILS --env prod`, no deploy
# needed to change it. See apps/api/src/admin.ts.
ADMIN_EMAILS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Your dev worker's URL, e.g. https://techno-optimists-dev.<subdomain>.workers.dev
# `npm run verify:dev` and `scripts/auth-doctor.mjs` both need a target and no
# longer hardcode one - the address carries an account-specific subdomain.
TO_DEV_BASE=
# Google Search Console ownership token - the content="..." value from the
# "HTML tag" method, NOT the whole tag. Read at build time by Base.astro; a
# build without it omits the tag entirely. Only the prod build needs it.
GSC_VERIFICATION=

# Slack alerts (apps/api/src/slack.ts). One bot token for the whole workspace.
# Unset = alerts log to the Worker console instead of posting, which is the right
# default for a clone. On a deployed Worker these are secrets, not vars:
# `wrangler secret put SLACK_BOT_TOKEN --env prod`. The bot must be invited to
# each channel or chat.postMessage answers 200 with `ok:false not_in_channel`.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_GROWTH=
SLACK_CHANNEL_PRODUCT=
SLACK_CHANNEL_ALERTS=

# Scout cron runner only: existing admin session for the API in cron.yaml.
# Sessions expire after 60 days. Never put this value in cron.yaml or git.
TO_SESSION=
# Optional: RSS feeds work without this; enables rotating web discovery.
BRAVE_SEARCH_API_KEY=
# Local models must already be installed in Ollama.
SCOUT_MODEL=qwen3.5:9b
SCOUT_VERIFY_MODEL=qwen3.5:9b
SCOUT_MODEL_BASE=http://localhost:11434
