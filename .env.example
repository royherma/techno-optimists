# Copy to .env (local) / .dev.vars (worker). Never commit the filled version.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Google Search Console ownership token - the content="..." value from the
# "HTML tag" method, NOT the whole tag. Read at build time by Base.astro; a
# build without it omits the tag entirely. Only the prod build needs it.
GSC_VERIFICATION=
