# Copy to .env (local) / .dev.vars (worker). Never commit the filled version.

# Comma-separated admin addresses, e.g. you@example.com,other@example.com.
# Unset means nobody is an admin, which is the right default for a clone - the
# site works, the import route just stays closed. On a deployed Worker this is a
# secret, not a var: `wrangler secret put ADMIN_EMAILS --env prod`, no deploy
# needed to change it. See apps/api/src/admin.ts.
ADMIN_EMAILS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Google Search Console ownership token - the content="..." value from the
# "HTML tag" method, NOT the whole tag. Read at build time by Base.astro; a
# build without it omits the tag entirely. Only the prod build needs it.
GSC_VERIFICATION=
