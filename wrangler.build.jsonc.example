{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techno-optimists-build",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // API only, NO assets binding. Astro's getStaticPaths fetches this at build
  // time; the main config serves apps/web/dist, and `astro build` empties that
  // directory mid-build, which takes the dev server down with it. Same local D1
  // state (.wrangler/state is shared by database_name), different port.

  "d1_databases": [
    { "binding": "DB", "database_name": "techno-optimists", "database_id": "<your-d1-id-techno-optimists>" },
    { "binding": "ANALYTICS_DB", "database_name": "to-analytics", "database_id": "<your-d1-id-to-analytics>" }
  ],

  "kv_namespaces": [
    { "binding": "CACHE", "id": "<your-kv-id-cache>" }
  ],

  // Same local bucket as the main config - the Worker binds MEDIA unconditionally.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "techno-optimists-media" }
  ]
}
