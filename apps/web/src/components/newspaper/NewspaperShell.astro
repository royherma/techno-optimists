---
import Legend from './Legend'
import type { Challenge } from '../../../../../packages/types'
import '../../styles/newspaper/shell.css'
import '../../styles/newspaper/content.css'
import '../../styles/newspaper/controls.css'
interface Props { challenges?: Challenge[]; section?: string }
const { challenges = [], section = 'Front page' } = Astro.props
---
<div class="newspaper">
  <a class="np-skip" href="#newspaper-main">Skip to content</a>
  <header class="np-masthead">
    <a class="np-motto" href="/">A brighter<br />tomorrow<br />builds today<span></span></a>
    <div class="np-nameplate"><a href="/">TechnoOptimists.org</a><p>People <i>×</i> Ideas <i>×</i> Technology <i>×</i> A better today <i>×</i> A brighter tomorrow</p></div>
    <blockquote>Explore.<br />Solve.<br />Build together<br />for a more human<br />tomorrow.</blockquote>
    <img class="np-orb" src="/images/optimist-orb.png" alt="" width="110" height="110" />
  </header>
  <nav class="np-navigation" aria-label="Main navigation">
    <a href="/" aria-current={section === 'Front page' ? 'page' : undefined}>Home</a>
    <a href="/?type=problem">Problems</a><a href="/?type=idea">Ideas</a><a href="/?type=experiment">Experiments</a><a href="/?type=build">Builds</a>
    <a href="/map" aria-current={section === 'World map' ? 'page' : undefined}>Map</a><a href="/people" aria-current={section === 'Community' ? 'page' : undefined}>Community</a>
    <div class="np-nav-end"><a href="/settings">Account</a><a class="np-submit" href="/post">＋ Share</a><button type="button" class="np-legend-toggle" data-legend-toggle aria-expanded="false">Legend</button><a href="/v1" data-classic-switch>V1 / Classic</a></div>
  </nav>
  <div class="np-workspace"><main id="newspaper-main" class="np-main"><slot /></main><aside class="np-sidebar" aria-label="Field guide and legend"><Legend client:load challenges={challenges} /></aside></div>
  <footer class="np-colophon"><span>Real problems. Real ideas. A brighter tomorrow.</span><nav aria-label="About this site"><a href="/contribute">Contribute</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></nav></footer>
</div>
<script>
  import { classicPath, editionPath } from '../../lib/edition'
  const root = document.querySelector('.newspaper')!
  const toggle = root.querySelector<HTMLButtonElement>('[data-legend-toggle]')!
  toggle.addEventListener('click', () => {
    const open = root.classList.toggle('is-legend-open')
    toggle.setAttribute('aria-expanded', String(open)); toggle.textContent = open ? 'Close legend' : 'Legend'
  })
  // Rewrite rendered links, including those produced later by shared React forms.
  // This also makes opening a link in a new tab preserve the selected edition.
  function links() {
    for (const link of root.querySelectorAll<HTMLAnchorElement>('a[href]')) {
      if (link.hasAttribute('data-classic-switch')) {
        link.href = classicPath(location.pathname) + location.search.replace(/([?&])v=[^&]*/g, '$1').replace(/[?&]$/, '')
        const url = new URL(link.href); url.searchParams.set('v', '1'); link.href = url.href
        continue
      }
      const value = link.getAttribute('href') || ''
      if (!value.startsWith('/') || value.startsWith('//')) continue
      const next = editionPath(value)
      if (next !== value) link.setAttribute('href', next)
    }
  }
  links()
  new MutationObserver(links).observe(root, { childList: true, subtree: true })
  const queryType = new URLSearchParams(location.search).get('type')
  if (queryType) root.querySelector(`.np-navigation a[href="/?type=${CSS.escape(queryType)}"]`)?.setAttribute('aria-current', 'page')
</script>
