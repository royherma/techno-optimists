---
import BrandIcon from './BrandIcon.astro'
const palette = ['spot', 'understand', 'ideas', 'test', 'improve']
const taglines = ['People', 'Ideas', 'Technology', 'A better today', 'A brighter tomorrow']
---
<header class="masthead">
  <a href="/" class="brand-mark" aria-label="Techno Optimists home"><BrandIcon size={46} /><span>A brighter<br />tomorrow<br />builds today</span></a>
  <div class="brand-title"><a href="/" aria-label="TechnoOptimists.org">{['Techno', 'Optimists', '.org'].map((word, wordIndex) => <span class="brand-letters" aria-hidden="true">{Array.from(word).map((letter, i) => <span class="brand-letter" style={`--delight-color: var(--color-${palette[(i + wordIndex) % palette.length]})`}>{letter}</span>)}</span>)}</a><p>{taglines.map((text, i) => <>{i > 0 && <> <span>×</span> </>}<b class="delight-word" style={`--delight-color: var(--color-${palette[i]})`}>{text}</b></>)}</p></div>
  <p class="brand-manifesto"><span class="manifesto-word delight-word">Explore</span><br /><span class="manifesto-word delight-word">Solve</span><br /><span class="manifesto-word delight-word">Build</span><br /><span class="manifesto-word delight-word">Together</span></p>
  <div class="brand-future"><img src="/images/optimist-orb.png" alt="" width="100" height="100" /><p><b class="delight-word">More</b><br /><b class="delight-word">human</b><br /><b class="delight-word">tomorrows</b></p></div>
</header>

<style>
  /* Each hit area stays still while its ink lifts; no JS or extra tab stops. */
  .brand-letters { white-space: nowrap; }
  .brand-letter, .delight-word {
    display: inline-block;
    transition: color 320ms ease-out, transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .delight-word { font-weight: inherit; --delight-color: var(--color-spot); }
  .delight-word:nth-of-type(2) { --delight-color: var(--color-ideas); }
  .delight-word:nth-of-type(3) { --delight-color: var(--color-test); }
  .delight-word:nth-of-type(4) { --delight-color: var(--color-understand); }
  .brand-title > a:focus-visible .brand-letter { color: var(--delight-color); }
  @media (hover: hover) and (pointer: fine) {
    .brand-letter:hover {
      color: var(--delight-color);
      transform: translateY(-0.055em) rotate(-3deg);
      transition-duration: 140ms;
    }
    .delight-word:hover {
      color: var(--delight-color);
      transform: translateY(-2px);
      transition-duration: 140ms;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand-letter, .delight-word { transform: none !important; transition: none; }
  }
</style>
