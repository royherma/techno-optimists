---
import type { ActionKind } from '../../../../packages/types/index'

/*
 * Map symbols for the typed actions. A survey legend teaches its symbols once
 * and then uses them unlabelled everywhere else, which is exactly the property
 * we want: after one read of the legend a row's marks are readable without
 * words, in any language. Drawn on one 24-unit grid so they optically match.
 */
interface Props { kind: ActionKind; size?: number }
const { kind, size = 26 } = Astro.props
const s = { width: size, height: size, viewBox: '0 0 24 24' }
---
{kind === 'have_problem' && (
  <svg {...s} role="presentation" class="shrink-0">
    <path d="M12 3v18M3 12h18" stroke="currentColor" stroke-width="3" stroke-linecap="square" />
  </svg>
)}
{kind === 'want_this' && (
  <svg {...s} role="presentation" class="shrink-0">
    <path d="M12 3v18M3 12h18" stroke="currentColor" stroke-width="3" stroke-linecap="square" />
  </svg>
)}
{kind === 'have_idea' && (
  <svg {...s} role="presentation" class="shrink-0">
    <path d="M12 2.5a6 6 0 0 0-3.4 10.9c.6.5.9 1.1.9 1.8v.6h5v-.6c0-.7.3-1.3.9-1.8A6 6 0 0 0 12 2.5Z"
          fill="none" stroke="currentColor" stroke-width="1.8" />
    <path d="M9.5 18.5h5M10.5 21h3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
  </svg>
)}
{kind === 'can_help' && (
  <svg {...s} role="presentation" class="shrink-0">
    <circle cx="12" cy="7" r="3" fill="currentColor" />
    <circle cx="5" cy="9" r="2.4" fill="currentColor" />
    <circle cx="19" cy="9" r="2.4" fill="currentColor" />
    <path d="M6 20c0-3.3 2.7-6 6-6s6 2.7 6 6" fill="currentColor" />
    <path d="M1 20c0-2.4 1.8-4.4 4-4.4M23 20c0-2.4-1.8-4.4-4-4.4"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
)}
{kind === 'will_test' && (
  <svg {...s} role="presentation" class="shrink-0">
    <path d="M6 3.5 20 12 6 20.5Z" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
  </svg>
)}
{kind === 'building_this' && (
  <svg {...s} role="presentation" class="shrink-0">
    <path d="M3 20h18M6 20V9l6-4.5L18 9v11" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" />
  </svg>
)}
{kind === 'follow' && (
  <svg {...s} role="presentation" class="shrink-0">
    <path d="m12 2.8 2.9 6 6.6.9-4.8 4.6 1.2 6.5-5.9-3.1-5.9 3.1 1.2-6.5L2.5 9.7l6.6-.9Z"
          fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
  </svg>
)}
