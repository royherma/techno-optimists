---
import '../styles/footer.css'
import HitCounter from './HitCounter'
import { getSiteViews } from '../lib/api'

/*
 * The colophon: who this is for, what the place is, and the two pages anyone
 * is entitled to read before handing over an email address.
 *
 * It is a full-bleed band at the end of the document. That is only possible
 * because the desktop frame was unlocked on 2026-09-11 - the shell used to be
 * a pinned 100dvh app frame with `body{overflow:hidden}`, so nothing could
 * live below the fold and two earlier footers died of exactly that (a mt-24
 * block in Base.astro, 3e1e0ac, and a strapline in the nav rail). See the
 * comment at the top of viewport.css.
 *
 * The band escapes the shell's 1920px max-width and 28px side padding, so it
 * runs edge to edge while the content above stays in its column. The escape is
 * done in CSS, not by moving the element out of the shell, because the shell is
 * the flex column that keeps a short page's footer at the bottom.
 *
 */
const year = new Date().getFullYear()

// Baked in at build time so the wheels open on the last known total instead of
// six zeros. The island rolls them up to the live figure on load.
const initialViews = await getSiteViews()
---
<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-line">For people who believe technology can build a better present and a better future.</p>

    <p class="footer-mission">
      Techno Optimists is a global community of people using technology to understand
      problems, try ideas and build better solutions together. Open source and open to
      your help: share a thread, bring your experience, or improve the site.
    </p>

    <nav class="footer-nav" aria-label="Site">
      <a href="/">Index</a>
      <a href="/map">Map</a>
      <a href="/post">Post a thread</a>
      <a href="/contribute">Contribute</a>
      <a href="https://github.com/royherma/techno-optimists">GitHub</a>
      <a href="mailto:roy@techguyverlabs.org">Contact</a>
      <a href="/terms">Terms</a>
      <a href="/privacy">Privacy</a>
    </nav>

    <p class="footer-mark">
      <span>Things can be better. We can build better.</span>
      <span class="footer-counter">Visits <HitCounter client:load initial={initialViews} /></span>
      <span class="footer-legal">{year} Techguyver Labs, LLC</span>
    </p>
  </div>
</footer>
