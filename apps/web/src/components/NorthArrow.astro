---
/* North arrow. Every sheet declares its orientation before it declares anything else. */
---
<svg viewBox="0 0 40 62" class="h-[4.5rem] w-11" role="img" aria-label="North">
  <text x="20" y="13" text-anchor="middle" font-size="15" font-weight="700"
        font-family="var(--font-mono)" fill="currentColor">N</text>
  <!-- Half-filled needle: the solid side is the convention for true north. -->
  <path d="M20 20 L30 58 L20 50 Z" fill="currentColor" />
  <path d="M20 20 L10 58 L20 50 Z" fill="none" stroke="currentColor" stroke-width="1.5" />
</svg>
