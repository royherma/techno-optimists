---
import type { Update, Challenge } from '../../../../../packages/types/index'
import { ago } from '../../lib/vocab'
import StageStamp from '../StageStamp.astro'
interface Props { updates: Update[]; stage: Challenge['stage'] }
const { updates, stage } = Astro.props
---
<section class="detail-section progress-log"><h2>Progress log</h2><p class="section-intro">What we’ve learned. What happens next.</p>
  {updates.length ? <ol>{updates.map(u => <li><span class="progress-dot" style={`background:var(--color-${u.stage ?? stage})`} aria-hidden="true"></span><div><div class="update-byline"><strong>@{u.author.handle}</strong>{u.stage && <StageStamp stage={u.stage} />}<span>{ago(u.created_at)}</span></div><p>{u.body}</p></div></li>)}</ol> : <p class="quiet-empty">Every discovery starts somewhere. Updates will appear here as this Challenge moves forward.</p>}
</section>
