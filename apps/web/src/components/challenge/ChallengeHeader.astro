---
import type { Challenge } from '../../../../../packages/types/index'
import { TYPE_LABEL, ago, gridRef } from '../../lib/vocab'
interface Props { challenge: Challenge }
const { challenge: c } = Astro.props
---
<header class="detail-header">
  <div class="detail-meta"><span>{gridRef(c.id)}</span><span class="type-pill">{TYPE_LABEL[c.type]}</span>{c.location && <span>{c.location}</span>}<span>Active {ago(c.last_activity_at)}</span></div>
  <h1 data-field="title">{c.title}</h1>
  <p class="detail-summary" data-field="summary">{c.summary}</p>
  <div class="detail-byline"><span class="author-avatar" aria-hidden="true">{c.author.handle.slice(0,1).toUpperCase()}</span><span>Spotted by <strong data-field="author">@{c.author.handle}</strong>{c.author.location && <span> · {c.author.location}</span>}</span></div>
  <div class="detail-impact">Impact not specified</div>
</header>
