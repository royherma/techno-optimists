---
import type { Challenge } from '../../../../packages/types/index'
import ActionGlyph from './ActionGlyph.astro'
import ContourRings from './ContourRings.astro'
import MediaPlate from './MediaPlate.astro'
import { ACTION_LABEL, count, depthLabel, gridRef, rowNo, stageColor, typeColor, TYPE_LABEL } from '../lib/vocab'
import { STAGE_STAMP } from '../lib/vocab'

interface Props { challenge: Challenge; rings: number; index: number; priority?: boolean }
const { challenge: c, rings, index, priority = false } = Astro.props
const hero = c.media[0]
const ref = gridRef(c.id)

/*
 * Four typed actions on every row, in a fixed order. Fixed matters: the sheet's
 * whole argument is that you learn the apparatus once and then read any row
 * without re-reading it, so these never reorder per Challenge the way the old
 * card's counts did.
 */
const ACTIONS = ['have_problem', 'have_idea', 'can_help', 'will_test'] as const
---
<!--
  A ruled table row, not a card. The columns are the ones the legend names -
  NO. / GRID REF. / CHALLENGE / IMPACT / STAGE - so the header strip at the top
  of the index keeps applying all the way down, which is what makes a table a
  table rather than a stack of boxes with lines between them.
-->
<!--
  Below sm there are no columns to place things into: five ruled cells cannot
  hold their meaning at 390px, and placing them by col-start/row-start anyway
  scattered a row into a tall zigzag - number top-left, rings floating right,
  stage stranded at the bottom. So the phone gets flow layout and the table
  starts at sm, where the widths exist.
-->
<article data-feed-row data-slug={c.slug} data-type={c.type} data-search={`${c.title} ${c.summary} ${c.location ?? ''} ${c.tags.join(' ')}`.toLowerCase()} class="challenge-row border-b border-(--color-rule) sm:grid sm:grid-cols-[3rem_9.5rem_1fr_6rem_8rem]">
  <!--
    NO. and GRID REF. share one line on a phone - they are both identifiers of
    the same row, and stacking them into separate ruled cells spent two blocks
    of vertical space saying where you are. The ruled cells return at sm.
  -->
  <div class="flex min-w-0 items-baseline gap-2.5 px-2.5 pt-3 sm:hidden">
    <span class="font-[family-name:var(--font-mono)] text-[0.82rem] font-semibold tabular-nums">{rowNo(index)}</span>
    <span class="font-[family-name:var(--font-mono)] text-[0.82rem] font-medium tracking-tight">{ref}</span>
    <!--
      `truncate` is inert without a bounded width, and a location runs to 120
      characters, so this line used to push the row off a phone instead of
      ending in an ellipsis. The flex parent needs `min-w-0` as much as the
      span does: without it the parent refuses to shrink below its content.
    -->
    {c.location && (
      <span class="min-w-0 flex-1 truncate text-[0.66rem] uppercase tracking-[0.06em] text-(--color-ink-soft)">
        {c.location}
      </span>
    )}
  </div>

  <!--
    NO. and GRID REF. are identifiers, not content - quieted to ink-soft so
    the CHALLENGE column, with its bolder title, reads as the column with the
    weight. Five ruled columns of equal darkness were competing evenly; only
    one of them is what the reader is here to skim.
  -->
  <!-- NO. -->
  <div class="hidden items-start justify-center border-r border-(--color-rule) px-1 py-4 sm:flex">
    <span class="font-[family-name:var(--font-mono)] text-[0.78rem] font-semibold tabular-nums text-(--color-ink-soft)">{rowNo(index)}</span>
  </div>

  <!-- GRID REF. Plus where it actually is, when the Challenge says. -->
  <div class="hidden flex-col gap-0.5 border-(--color-rule) px-2.5 py-4 sm:flex sm:border-r">
    <span class="font-[family-name:var(--font-mono)] text-[0.78rem] font-medium tracking-tight text-(--color-ink-soft)">{ref}</span>
    {c.location && (
      <span class="text-[0.64rem] uppercase leading-tight tracking-[0.06em] text-(--color-ink-faint)">
        {c.location}
      </span>
    )}
  </div>

  <!-- CHALLENGE: the photograph, the problem stated plainly, and what you can do. -->
  <div class="border-(--color-rule) px-2.5 py-3 sm:border-r sm:py-4">
    <div class="flex gap-3.5">
      <!--
        A media object can go missing - an upload that half-landed, an R2 key
        deleted behind the row that still references it. The tinted box is
        already the right shape and colour, so dropping the broken <img> leaves
        a plate that reads as intentional rather than as a failure.
      -->
      <!--
        The photograph shows on a phone too. It used to be `hidden sm:block`,
        so every reader under 640px got twelve rows of text - and a product
        whose first principle is that browsing comes before contributing
        cannot be text-only on the device most people browse it on.
      -->
      {hero && <a href={`/c/${c.slug}`} class="w-20 shrink-0 sm:w-28">
        <MediaPlate media={hero} fit="cover" eager={priority} min={0.75} max={1.6} class="w-full" />
      </a>}

      <div class="min-w-0">
        <a href={`/c/${c.slug}`} class="block">
          <!--
            The Challenge TYPE (problem/idea/experiment/build) used to show
            nowhere on a feed row, only stage did. Type is what the row IS,
            so it sits as a small tinted label above the title rather than a
            sixth column - it uses the same `typeColor` the legend and the
            entry page already key off.
          -->
          <span
            class="text-[0.68rem] font-bold uppercase tracking-[0.08em]"
            style={`color:${typeColor(c.type)}`}
          >{TYPE_LABEL[c.type]}</span>
          <!--
            Title carries the weight now (bold, tighter leading) so a reader
            can skim titles alone down the column; the summary drops in size
            and colour so it reads as clearly secondary, not a second title.
          -->
          <h2 class="mt-0.5 font-[family-name:var(--font-display)] text-[1.4rem] font-bold leading-[1.1] tracking-tight sm:text-[1.55rem]">
            <span data-feed-emoji aria-hidden="true">{c.emoji ? `${c.emoji} ` : ''}</span><span data-feed-title>{c.title}</span>
          </h2>
          <!--
            A summary runs to 280 characters. Ordinary prose wraps, but one
            unbroken 280-character token (a pasted URL) is a single word no
            amount of `min-w-0` can fold, so it rules a line straight through
            the neighbouring cells. Clamped to two lines in the index; the
            entry page shows it whole.
          -->
          <p data-feed-summary class="mt-1.5 line-clamp-2 max-w-xl text-[0.8rem] leading-relaxed break-words text-(--color-ink-faint)">{c.summary}</p>
        </a>

        <!--
          The glyphs from the legend, used unlabelled beside their counts. This
          is the payoff for having a legend at all: once you know the symbols
          the row costs one glance instead of a sentence each. Quieted to
          faint text on no border so they read as metadata beside the summary
          rather than as buttons competing with the title.
        -->
        <div class="mt-2.5 flex flex-wrap gap-x-4 gap-y-1.5">
          {ACTIONS.map((k) => (
            <a
              href={`/c/${c.slug}#contribute`}
              data-action={k}
              data-challenge={c.slug}
              title={ACTION_LABEL[k]}
              aria-label={`${ACTION_LABEL[k]} - ${c.actions[k]}`}
              class="flex items-center gap-1.5 text-[0.75rem] text-(--color-ink-faint) transition-colors hover:text-(--color-ink)"
            >
              <ActionGlyph kind={k} size={14} />
              <span class="font-semibold tabular-nums">{count(c.actions[k])}</span>
            </a>
          ))}
          {c.views_count > 0 && (
            <span
              title="Distinct viewers, counted once per person per day"
              aria-label={`Viewed - ${c.views_count}`}
              class="flex items-center gap-1.5 text-[0.75rem] text-(--color-ink-faint)"
            >
              <span class="font-semibold tabular-nums">{count(c.views_count)}</span>
              <span>viewed</span>
            </span>
          )}
        </div>
      </div>
    </div>
  </div>

  <!--
    On a phone impact and stage sit together on one line: both answer "how far
    does this reach and what is being done about it", and the rings are read
    against the stamp's colour. Apart, they were a mark in one corner and a
    word in another. They split back into their own ruled columns at sm.
  -->
  <div class="flex items-center gap-2.5 px-2.5 pb-3 sm:hidden">
    <ContourRings
      rings={rings}
      color={stageColor(c.stage)}
      label={`Impact: ${depthLabel(rings)}`}
      size={26}
    />
    <span
      class="font-[family-name:var(--font-display)] text-[1.05rem] font-bold uppercase tracking-[0.02em]"
      style={`color:${stageColor(c.stage)}`}
    >{STAGE_STAMP[c.stage]}</span>
  </div>

  <!-- IMPACT: rings in the stage colour, centred in their own ruled cell. -->
  <div class="hidden items-center justify-center border-(--color-rule) px-1 py-4 sm:flex sm:border-r">
    <ContourRings
      rings={rings}
      color={stageColor(c.stage)}
      label={`Impact: ${depthLabel(rings)}`}
      size={44}
    />
  </div>

  <!-- STAGE: the margin stamp, in its own cell so the colour column reads down. -->
  <div class="hidden items-center px-2.5 sm:flex sm:justify-center sm:py-4">
    <span
      class="font-[family-name:var(--font-display)] text-[1.05rem] font-bold uppercase tracking-[0.02em]"
      style={`color:${stageColor(c.stage)}`}
    >{STAGE_STAMP[c.stage]}</span>
  </div>
</article>
