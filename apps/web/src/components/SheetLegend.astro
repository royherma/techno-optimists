---
import ActionGlyph from './ActionGlyph.astro'
import ContourRings from './ContourRings.astro'
import { STAGES } from '../../../../packages/types/index'
import { IMPACT_LABELS, LEGEND_ACTIONS, LEGEND_ACTION_LABEL, STAGE_MEANING, STAGE_STAMP } from '../lib/vocab'

/*
 * The legend is not decoration and not a nav. It is how a first-time reader
 * learns the three marks the sheet uses, which is why it stands beside the
 * index rather than hiding behind a help link. Reading it teaches the whole
 * product: what reach looks like, what the lifecycle is, and what you can do.
 *
 * Every tier is shown, not a sample. A legend that lists three of five rings
 * leaves the reader guessing at the two it skipped, which is the one thing a
 * legend exists to prevent.
 */
---
<!--
  On a phone the legend is closed. Open, it runs 823px - five ring tiers, seven
  stages and five actions - so a reader met a full screen of apparatus before
  the first thread. Putting it last was worse (it landed at 4254px, after
  everything it explains), so neither end of the page is the answer: it sits
  above row one as a single line the reader can open when a mark puzzles them.

  From lg the sidebar has the room to show it whole, so the disclosure stops
  being one: the summary is hidden and the sections are revealed in CSS. A
  media query cannot add or remove the `open` attribute, which is why the
  breakpoint reveals the content rather than toggling state.
-->
<details class="sheet-legend group border-2 border-(--color-rule) bg-(--color-paper)" aria-label="Legend" open>
  <summary class="ink-transition cursor-pointer list-none border-b border-(--color-rule) px-3 py-1.5 font-[family-name:var(--font-display)] text-[1.15rem] font-bold uppercase tracking-[0.02em] hover:bg-(--color-paper-sunk)">
    Legend
    <span class="float-right font-[family-name:var(--font-mono)] text-[0.7rem] font-normal normal-case tracking-normal text-(--color-ink-soft) group-open:hidden">
      what the marks mean
    </span>
  </summary>

  <section class="border-b border-(--color-rule) px-3 py-2.5">
    <h3 class="font-[family-name:var(--font-mono)] text-[0.68rem] font-bold uppercase tracking-[0.06em]">
      Impact (contour rings)
    </h3>
    <ul class="mt-2">
      {[1, 2, 3, 4, 5].map((n) => (
        <li class="feedback-row flex items-center gap-3 py-[0.15rem]">
          <span class="flex w-11 shrink-0 justify-center">
            <ContourRings rings={n} label="" size={22 + n * 5} />
          </span>
          <span class="text-[0.78rem] text-(--color-ink-soft)">
            <span class="tabular-nums text-(--color-ink)">{n}</span>
            {n === 1 ? ' ring = ' : ' rings = '}
            <span class="text-(--color-ink)">{IMPACT_LABELS[n - 1]}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-b border-(--color-rule) px-3 py-2.5">
    <h3 class="font-[family-name:var(--font-mono)] text-[0.68rem] font-bold uppercase tracking-[0.06em]">
      Thread stages (7 steps)
    </h3>
    <ul class="mt-2 space-y-[0.2rem]">
      {STAGES.map((s) => (
        <li class="feedback-row flex items-center gap-2">
          <span class="h-3 w-6 shrink-0" style={`background:var(--color-${s})`}></span>
          <span class="text-[0.78rem] leading-tight">
            <span class="font-bold uppercase tracking-[0.02em]" style={`color:var(--color-${s})`}>
              {STAGE_STAMP[s]}
            </span>
            <span class="text-(--color-ink-soft)"> - {STAGE_MEANING[s]}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section class="px-3 py-2.5">
    <h3 class="font-[family-name:var(--font-mono)] text-[0.68rem] font-bold uppercase tracking-[0.06em]">
      Actions
    </h3>
    <ul class="mt-2">
      {LEGEND_ACTIONS.map((k) => (
        <li class="feedback-row flex items-center gap-3 py-[0.15rem]">
          <span class="flex w-11 shrink-0 justify-center"><ActionGlyph kind={k} /></span>
          <span class="text-[0.78rem]">{LEGEND_ACTION_LABEL[k]}</span>
        </li>
      ))}
    </ul>
  </section>
</details>

<style>
  /*
   * From lg the legend lives in its own column, where there is room to show it
   * whole - so the disclosure stops being a disclosure: the summary goes, and
   * the sections show whether or not the element carries `open`. A media query
   * cannot remove the `open` attribute, so the content is revealed in CSS
   * rather than by toggling state.
   */
  @media (min-width: 64rem) {
    /*
     * The summary stays - it is the legend's heading, and hiding the whole
     * element took the word LEGEND off the sidebar with it. Only the parts
     * that offer to open something go: the marker and the hint.
     */
    .sheet-legend > summary {
      cursor: default;
      pointer-events: none;
    }
    .sheet-legend > summary > span {
      display: none;
    }
  }
</style>

<script>
  /*
   * The element ships `open` so it is complete without JavaScript and in the
   * sidebar, where there is room for it. Only the phone needs it shut, and no
   * media query can remove an attribute - so the one place state has to change
   * is the one place CSS cannot reach.
   */
  ;(() => {
    const mq = window.matchMedia('(min-width: 64rem)')
    const sync = () => {
      for (const el of document.querySelectorAll<HTMLDetailsElement>('.sheet-legend')) {
        if (!mq.matches && !el.dataset.touched) el.open = false
        if (mq.matches) el.open = true
      }
    }
    for (const el of document.querySelectorAll<HTMLDetailsElement>('.sheet-legend')) {
      el.querySelector('summary')?.addEventListener('click', () => { el.dataset.touched = '1' })
    }
    sync()
    mq.addEventListener('change', sync)
  })()
</script>
