---
import ContourRings from './ContourRings.astro'
import { STAGES } from '../../../../packages/types/index'
import { DEPTH_LABEL, STAGE_MEANING, STAGE_STAMP } from '../lib/vocab'

/*
 * The legend is not decoration and not a nav. It is how a first-time reader
 * learns the two marks the sheet uses, which is why it stands beside the index
 * rather than hiding behind a help link. Reading it teaches the whole product.
 */
---
<aside class="border border-(--color-rule) p-4 text-[0.82rem]" aria-label="Legend">
  <h2 class="text-[0.72rem] font-semibold uppercase tracking-[0.14em]">Legend</h2>

  <h3 class="mt-4 text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-(--color-ink-soft)">
    Stage
  </h3>
  <ul class="mt-2 space-y-1.5">
    {STAGES.map((s) => (
      <li class="flex items-baseline gap-2">
        <span class="mt-1 h-2.5 w-2.5 shrink-0 self-start" style={`background:var(--color-${s})`}></span>
        <span>
          <span class="font-semibold uppercase tracking-[0.04em]" style={`color:var(--color-${s})`}>
            {STAGE_STAMP[s]}
          </span>
          <span class="text-(--color-ink-soft)"> - {STAGE_MEANING[s]}</span>
        </span>
      </li>
    ))}
  </ul>

  <h3 class="mt-5 text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-(--color-ink-soft)">
    Contour rings
  </h3>
  <p class="mt-1.5 text-(--color-ink-soft)">How much has accumulated on a Challenge.</p>
  <ul class="mt-2.5 space-y-1.5">
    {[1, 3, 5].map((n) => (
      <li class="flex items-center gap-3">
        <ContourRings rings={n} label="" size={38} />
        <span class="text-(--color-ink-soft)">
          <span class="tabular-nums text-(--color-ink)">{n}</span>
          {n === 1 ? ' ring = ' : ' rings = '}{DEPTH_LABEL[n - 1]}
        </span>
      </li>
    ))}
  </ul>

  <h3 class="mt-5 text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-(--color-ink-soft)">
    Actions
  </h3>
  <p class="mt-1.5 text-(--color-ink-soft)">
    Every response says what kind it is. There is no generic like, because
    "I have this problem" and "I can help" are different facts.
  </p>
</aside>
