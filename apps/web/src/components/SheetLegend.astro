---
import ActionGlyph from './ActionGlyph.astro'
import ContourRings from './ContourRings.astro'
import { STAGES } from '../../../../packages/types/index'
import { DEPTH_LABEL, LEGEND_ACTIONS, LEGEND_ACTION_LABEL, STAGE_MEANING, STAGE_STAMP } from '../lib/vocab'

/*
 * The legend is not decoration and not a nav. It is how a first-time reader
 * learns the three marks the sheet uses, which is why it stands beside the
 * index rather than hiding behind a help link. Reading it teaches the whole
 * product: what reach looks like, what the lifecycle is, and what you can do.
 *
 * Every tier is shown, not a sample. A legend that lists three of five rings
 * leaves the reader guessing at the two it skipped, which is the one thing a
 * legend exists to prevent.
 */
---
<aside class="border-2 border-(--color-rule) bg-(--color-paper)" aria-label="Legend">
  <h2 class="border-b border-(--color-rule) px-3 py-1.5 font-[family-name:--font-display] text-[1.15rem] font-bold uppercase tracking-[0.02em]">
    Legend
  </h2>

  <section class="border-b border-(--color-rule) px-3 py-2.5">
    <h3 class="font-[family-name:--font-mono] text-[0.68rem] font-bold uppercase tracking-[0.06em]">
      Impact (contour rings)
    </h3>
    <ul class="mt-2">
      {[1, 2, 3, 4, 5].map((n) => (
        <li class="flex items-center gap-3 py-[0.15rem]">
          <span class="flex w-11 shrink-0 justify-center">
            <ContourRings rings={n} label="" size={22 + n * 5} />
          </span>
          <span class="text-[0.78rem] text-(--color-ink-soft)">
            <span class="tabular-nums text-(--color-ink)">{n}</span>
            {n === 1 ? ' ring = ' : ' rings = '}
            <span class="text-(--color-ink)">{DEPTH_LABEL[n - 1]}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-b border-(--color-rule) px-3 py-2.5">
    <h3 class="font-[family-name:--font-mono] text-[0.68rem] font-bold uppercase tracking-[0.06em]">
      Challenge stages (7 steps)
    </h3>
    <ul class="mt-2 space-y-[0.2rem]">
      {STAGES.map((s) => (
        <li class="flex items-center gap-2">
          <span class="h-3 w-6 shrink-0" style={`background:var(--color-${s})`}></span>
          <span class="text-[0.78rem] leading-tight">
            <span class="font-bold uppercase tracking-[0.02em]" style={`color:var(--color-${s})`}>
              {STAGE_STAMP[s]}
            </span>
            <span class="text-(--color-ink-soft)"> &mdash; {STAGE_MEANING[s]}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section class="px-3 py-2.5">
    <h3 class="font-[family-name:--font-mono] text-[0.68rem] font-bold uppercase tracking-[0.06em]">
      Actions
    </h3>
    <ul class="mt-2">
      {LEGEND_ACTIONS.map((k) => (
        <li class="flex items-center gap-3 py-[0.15rem]">
          <span class="flex w-11 shrink-0 justify-center"><ActionGlyph kind={k} /></span>
          <span class="text-[0.78rem]">{LEGEND_ACTION_LABEL[k]}</span>
        </li>
      ))}
    </ul>
  </section>
</aside>
