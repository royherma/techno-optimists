---
import Base from '../layouts/Base.astro'
import Sheet from '../components/Sheet.astro'
import { getFeed } from '../lib/api'

/*
 * Without this file the build emits no 404.html, so ASSETS.fetch answered a
 * mistyped or deleted /c/<slug> with its own bare 404 - a completely blank
 * page. The Worker already returns the right status; it had nothing to serve.
 *
 * A miss is still a page of the same document, so it renders inside the Sheet
 * with a way back to the index rather than dead-ending the reader.
 */
const { challenges } = await getFeed('?limit=3')
---
<Base title="Not on this sheet - Techno Optimists" description="That Challenge is not on this sheet.">
  <Sheet sheet="00" live={challenges.length}>
    <main class="px-5 py-16">
      <p class="font-[family-name:--font-mono] text-[0.7rem] uppercase tracking-[0.1em] text-(--color-ink-soft)">
        Sheet 00 - no such entry
      </p>
      <h1 class="mt-3 max-w-2xl font-[family-name:--font-display] text-[1.75rem] leading-[1.12] tracking-tight sm:text-[2.1rem]">
        That Challenge is not on this sheet
      </h1>
      <p class="mt-3 max-w-xl text-lg leading-relaxed text-(--color-ink-soft)">
        The link may be mistyped, or the entry may have been withdrawn by the person who posted it.
      </p>

      <a
        href="/"
        class="mt-8 inline-block border border-(--color-rule) px-4 py-2.5 font-[family-name:--font-mono] text-[0.7rem] uppercase tracking-[0.1em] hover:bg-(--color-ink) hover:text-(--color-paper)"
      >
        Back to the index
      </a>

      {challenges.length > 0 && (
        <section class="mt-12 border-t border-(--color-rule) pt-6">
          <h2 class="font-[family-name:--font-mono] text-[0.68rem] font-bold uppercase tracking-[0.06em]">
            Recently active
          </h2>
          <ul class="mt-3">
            {challenges.map((c) => (
              <li class="border-b border-(--color-rule-soft) py-2.5">
                <a href={`/c/${c.slug}`} class="text-[0.95rem] leading-snug hover:underline">{c.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </main>
  </Sheet>
</Base>
