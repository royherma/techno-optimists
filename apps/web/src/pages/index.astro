---
import Base from '../layouts/Base.astro'
import NewspaperShell from '../components/newspaper/NewspaperShell.astro'
import FrontPage from '../components/newspaper/FrontPage'
import { getFeed } from '../lib/api'
const { challenges } = await getFeed('?limit=50')
---
<Base title="Techno Optimists: Real-World Problems to Solve Together" description="Techno Optimists is a global community using technology to understand real-world problems, try ideas and build better solutions together." imageAlt="Techno Optimists: real-world problems, solved together"><NewspaperShell challenges={challenges}><FrontPage initial={challenges} client:load /></NewspaperShell></Base>
