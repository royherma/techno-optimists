---
import Base from '../layouts/Base.astro'
import ChallengeRow from '../components/ChallengeRow.astro'
import Sheet from '../components/Sheet.astro'
import SheetLegend from '../components/SheetLegend.astro'
import { getFeed } from '../lib/api'
import { TYPE_LABEL, depthScale, sheetNo } from '../lib/vocab'
import { CHALLENGE_TYPES } from '../../../../packages/types/index'

const type = Astro.url.searchParams.get('type') ?? ''
const valid = (CHALLENGE_TYPES as readonly string[]).includes(type)
const { challenges } = await getFeed(`?limit=24${valid ? `&type=${type}` : ''}`)

// Ring depth is relative to the sheet in front of the reader, so it is scaled
// once here rather than per row.
const depth = depthScale(challenges)
---
<Base title="Techno Optimists - find real problems, help solve them">
  <Sheet sheet={sheetNo(valid ? type : '')} live={challenges.length} rows={challenges.length}>
    <div class="lg:grid lg:grid-cols-[1fr_19.5rem]">
      <!-- The index proper. -->
      <div class="min-w-0 border-(--color-rule) lg:border-r">
        <nav
          class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-(--color-rule) px-3 py-2 font-[family-name:--font-mono] text-[0.7rem] uppercase tracking-[0.06em]"
          aria-label="Filter by type"
        >
          <span class="font-bold">Index</span>
          <a
            href="/"
            aria-current={valid ? undefined : 'page'}
            class:list={[valid ? 'text-(--color-ink-soft) hover:text-(--color-ink)' : 'font-bold underline underline-offset-4']}
          >Everything</a>
          {CHALLENGE_TYPES.map((t) => (
            <a
              href={`/?type=${t}`}
              aria-current={type === t ? 'page' : undefined}
              class:list={[type === t ? 'font-bold underline underline-offset-4' : 'text-(--color-ink-soft) hover:text-(--color-ink)']}
            >{TYPE_LABEL[t]}</a>
          ))}
        </nav>

        <!--
          Column headers, ruled to match the rows beneath them. These are the
          same five names the legend uses; a reader who learns the legend has
          already learned this strip.
        -->
        <div class="sticky top-0 z-10 grid grid-cols-[2.6rem_1fr_4.5rem] border-b-2 border-(--color-rule) bg-(--color-paper) font-[family-name:--font-mono] text-[0.68rem] font-bold uppercase tracking-[0.06em] sm:grid-cols-[3rem_9.5rem_1fr_6rem_8rem]">
          <span class="border-r border-(--color-rule) px-1 py-1.5 text-center">No.</span>
          <span class="col-span-2 border-(--color-rule) px-2.5 py-1.5 sm:col-span-1 sm:border-r">Grid ref.</span>
          <span class="hidden border-r border-(--color-rule) px-2.5 py-1.5 sm:block">Challenge</span>
          <span class="col-start-3 row-start-1 border-(--color-rule) px-1 py-1.5 text-center sm:col-start-4 sm:row-start-auto sm:border-r">Impact</span>
          <span class="hidden px-2.5 py-1.5 text-center sm:block">Stage</span>
        </div>

        {challenges.length === 0 ? (
          <p class="px-4 py-16 text-(--color-ink-soft)">
            Nothing on this sheet yet. Try another part of the index.
          </p>
        ) : (
          challenges.map((c, i) => (
            <ChallengeRow challenge={c} rings={depth(c)} index={i} priority={i < 2} />
          ))
        )}
      </div>

      <div class="p-3">
        <div class="lg:sticky lg:top-3"><SheetLegend /></div>
      </div>
    </div>
  </Sheet>
</Base>
