---
import Base from '../../layouts/Base.astro'
import ActionBar from '../../components/ActionBar'
import { getChallenge, getFeed } from '../../lib/api'
import { ACTION_DOING, ACTION_SHORT, STAGE_LABEL, STAGE_ORDER, TYPE_LABEL, ago, count, typeColor } from '../../lib/vocab'
import { ACTION_KINDS } from '../../../../../packages/types/index'

export async function getStaticPaths() {
  const { challenges } = await getFeed('?limit=50')
  return challenges.map((c) => ({ params: { slug: c.slug } }))
}

const { slug } = Astro.params
const { challenge: c, updates, people } = await getChallenge(slug!)
const hero = c.media[0]
const reached = STAGE_ORDER.indexOf(c.stage)
const ranked = ACTION_KINDS.map((k) => [k, c.actions[k]] as const)
  .filter(([, n]) => n > 0).sort((a, b) => b[1] - a[1])
---
<Base title={`${c.title} - Techno Optimists`} description={c.summary}>
  <main class="mx-auto max-w-3xl px-5 py-10">
    <a href="/" class="text-sm text-(--color-ink-soft) hover:text-(--color-ink)">&larr; All challenges</a>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <span class="rounded-full px-2.5 py-1 text-xs font-medium text-white"
            style={`background:${typeColor(c.type)}`}>{TYPE_LABEL[c.type]}</span>
      {c.location && <span class="text-sm text-(--color-ink-soft)">{c.location}</span>}
      <span class="text-sm text-(--color-ink-faint)">Active {ago(c.last_activity_at)}</span>
    </div>

    <h1 class="mt-3 font-[family-name:--font-display] text-[2.4rem] leading-[1.12] tracking-tight">
      {c.title}
    </h1>
    <p class="mt-3 text-lg leading-relaxed text-(--color-ink-soft)">{c.summary}</p>

    <p class="mt-4 text-sm text-(--color-ink-soft)">
      Spotted by <span class="font-medium text-(--color-ink)">{c.author.name}</span>
      {c.author.location && <span class="text-(--color-ink-faint)"> · {c.author.location}</span>}
    </p>

    {hero && (
      <img src={hero.url} alt={hero.alt ?? ''} loading="eager"
           class="mt-6 aspect-[16/10] w-full rounded-lg object-cover"
           style={`background:${hero.tint}`} />
    )}

    <!-- Lifecycle. Shows where this sits without implying the end is the point. -->
    <ol class="mt-8 flex flex-wrap gap-1.5" aria-label="Lifecycle stage">
      {STAGE_ORDER.map((s, i) => (
        <li class={`rounded px-2 py-1 text-xs ${
          i < reached ? 'bg-(--color-paper-sunk) text-(--color-ink-faint)'
          : i === reached ? 'bg-(--color-ink) text-(--color-paper)'
          : 'text-(--color-ink-faint)'}`}>{STAGE_LABEL[s]}</li>
      ))}
    </ol>

    <section class="mt-8 border-y border-(--color-rule) py-6">
      <h2 class="mb-3 text-sm font-medium text-(--color-ink-soft)">How can you help?</h2>
      <ActionBar client:load slug={c.slug} type={c.type} actions={c.actions} />
      <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-(--color-ink-faint)">
        {ranked.map(([k, n]) => (
          <span><strong class="tabular-nums text-(--color-ink-soft)">{count(n)}</strong> {ACTION_SHORT[k]}</span>
        ))}
      </div>
    </section>

    {people.length > 0 && (
      <section class="mt-8">
        <h2 class="font-[family-name:--font-display] text-xl">People on this</h2>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          {people.map((p) => (
            <li class="rounded-lg border border-(--color-rule) px-3.5 py-2.5">
              <div class="flex items-baseline justify-between gap-2">
                <p class="text-sm font-medium">{p.name}</p>
                <p class="shrink-0 text-xs text-(--color-signal)">
                  {p.kinds.map((k) => ACTION_DOING[k]).join(' · ')}
                </p>
              </div>
              <p class="text-xs text-(--color-ink-faint)">
                {p.skills.slice(0, 3).join(' · ')}{p.location && ` · ${p.location}`}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {updates.length > 0 && (
      <section class="mt-10">
        <h2 class="font-[family-name:--font-display] text-xl">Progress</h2>
        <ol class="mt-4 space-y-6">
          {updates.map((u) => (
            <li class="border-l-2 border-(--color-rule) pl-4">
              <div class="flex flex-wrap items-baseline gap-2 text-sm">
                <span class="font-medium">{u.author.name}</span>
                {u.stage && (
                  <span class="rounded bg-(--color-paper-sunk) px-1.5 py-0.5 text-xs text-(--color-ink-soft)">
                    {STAGE_LABEL[u.stage]}
                  </span>
                )}
                <span class="text-xs text-(--color-ink-faint)">{ago(u.created_at)}</span>
              </div>
              <p class="mt-1.5 leading-relaxed text-(--color-ink-soft)">{u.body}</p>
            </li>
          ))}
        </ol>
      </section>
    )}
  </main>
</Base>
