---
import Base from '../../layouts/Base.astro'
import Sheet from '../../components/Sheet.astro'
import PageToolbar from '../../components/PageToolbar.astro'
import ChallengeDetail from '../../components/challenge/ChallengeDetail'
import { getChallenge, getFeed } from '../../lib/api'
import { depthScale } from '../../lib/vocab'
import '../../styles/detail.css'
import '../../styles/discussion.css'
export async function getStaticPaths() {
  const { challenges } = await getFeed('?limit=50')
  return challenges.map(c => ({ params: { slug: c.slug } }))
}
const { slug } = Astro.params
const { challenge: c, updates, people } = await getChallenge(slug!)
const { challenges: peers } = await getFeed('?limit=50')
const rings = depthScale(peers.some(p => p.id === c.id) ? peers : [...peers,c])(c)
---
<Base title={`${c.title} - Techno Optimists`} description={c.summary}>
  <Sheet>
    <PageToolbar label="Challenge" />
    <main class="challenge-detail"><ChallengeDetail client:load initial={{ challenge: c, updates, people }} rings={rings} /></main>
  </Sheet>
</Base>
