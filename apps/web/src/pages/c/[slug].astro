---
import Base from '../../layouts/Base.astro'
import ActionBar from '../../components/ActionBar'
import ContourRings from '../../components/ContourRings.astro'
import StageStamp from '../../components/StageStamp.astro'
import { getChallenge, getFeed } from '../../lib/api'
import {
  ACTION_DOING, ACTION_SHORT, STAGE_MEANING, STAGE_ORDER, STAGE_STAMP,
  TYPE_LABEL, ago, count, depthLabel, depthScale, gridRef,
} from '../../lib/vocab'
import { ACTION_KINDS } from '../../../../../packages/types/index'

export async function getStaticPaths() {
  const { challenges } = await getFeed('?limit=50')
  return challenges.map((c) => ({ params: { slug: c.slug } }))
}

const { slug } = Astro.params
const { challenge: c, updates, people } = await getChallenge(slug!)
const hero = c.media[0]
const reached = STAGE_ORDER.indexOf(c.stage)

// Same scale the index uses, so a Challenge shows the same rings in both places.
const { challenges: peers } = await getFeed('?limit=50')
const rings = depthScale(peers.some((p) => p.id === c.id) ? peers : [...peers, c])(c)
const ref = gridRef(c.id)
const ranked = ACTION_KINDS.map((k) => [k, c.actions[k]] as const)
  .filter(([, n]) => n > 0).sort((a, b) => b[1] - a[1])
---
<Base title={`${c.title} - Techno Optimists`} description={c.summary}>
  <main class="mx-auto max-w-[76rem] px-5 py-8">
    <a href="/" class="text-[0.8rem] uppercase tracking-[0.1em] text-(--color-ink-soft) hover:text-(--color-ink)">
      &larr; Back to the index
    </a>

    <!-- Entry header: the same marks as the index row, so the sheet stays one sheet. -->
    <div class="mt-5 flex flex-wrap items-start justify-between gap-x-8 gap-y-4 border-b-2 border-(--color-rule) pb-5">
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-[0.75rem] uppercase tracking-[0.1em] text-(--color-ink-soft)">
          <span class="font-[family-name:--font-mono] tracking-tight text-(--color-ink)">{ref}</span>
          <span>{TYPE_LABEL[c.type]}</span>
          {c.location && <span>{c.location}</span>}
          <span>Active {ago(c.last_activity_at)}</span>
        </div>
        <h1 class="mt-2.5 max-w-3xl font-[family-name:--font-display] text-[2.4rem] leading-[1.1] tracking-tight">
          {c.title}
        </h1>
        <p class="mt-2.5 max-w-2xl text-lg leading-relaxed text-(--color-ink-soft)">{c.summary}</p>
        <p class="mt-3 text-sm text-(--color-ink-soft)">
          Spotted by <span class="font-medium text-(--color-ink)">{c.author.name}</span>
          {c.author.location && <span class="text-(--color-ink-faint)"> · {c.author.location}</span>}
        </p>
      </div>

      <div class="flex items-center gap-4">
        <div class="text-(--color-ink)">
          <ContourRings rings={rings} label={`Investigation depth: ${depthLabel(rings)}`} size={54} />
        </div>
        <div>
          <StageStamp stage={c.stage} class="text-[1.3rem]" />
          <p class="mt-0.5 text-[0.75rem] text-(--color-ink-soft)">{STAGE_MEANING[c.stage]}</p>
        </div>
      </div>
    </div>

    {hero && (
      <img src={hero.url} alt={hero.alt ?? ''} loading="eager"
           class="mt-6 aspect-[16/9] w-full border border-(--color-rule) object-cover"
           style={`background:${hero.tint}`} />
    )}

    <!--
      Lifecycle as ordered stations rather than a status field: you read left to
      right and see the handoffs, which is what makes the sequence legible.
    -->
    <ol class="mt-8 grid grid-cols-[repeat(7,minmax(0,1fr))] gap-px border border-(--color-rule) bg-(--color-rule-soft)"
        aria-label="Lifecycle stage">
      {STAGE_ORDER.map((s, i) => (
        <li class="bg-(--color-paper) px-2 py-2.5 text-center">
          <span class="block h-1" style={i <= reached ? `background:var(--color-${s})` : ''}></span>
          <span
            class:list={['mt-2 block text-[0.68rem] font-semibold uppercase tracking-[0.05em]',
                         i > reached && 'text-(--color-ink-faint)']}
            style={i <= reached ? `color:var(--color-${s})` : ''}
          >{STAGE_STAMP[s]}</span>
          {i === reached && (
            <span class="mt-0.5 block text-[0.62rem] uppercase tracking-[0.08em] text-(--color-ink-soft)">now</span>
          )}
        </li>
      ))}
    </ol>

    <div class="mt-8 gap-10 lg:grid lg:grid-cols-[1fr_18rem]">
      <div class="min-w-0">
        <section class="border-y border-(--color-rule) py-5">
          <h2 class="mb-3 text-[0.72rem] font-semibold uppercase tracking-[0.14em]">How can you help?</h2>
          <ActionBar client:load slug={c.slug} type={c.type} actions={c.actions} />
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-(--color-ink-faint)">
            {ranked.map(([k, n]) => (
              <span><strong class="tabular-nums text-(--color-ink-soft)">{count(n)}</strong> {ACTION_SHORT[k]}</span>
            ))}
          </div>
        </section>

        {updates.length > 0 && (
          <section class="mt-8">
            <h2 class="text-[0.72rem] font-semibold uppercase tracking-[0.14em]">Progress log</h2>
            <ol class="mt-4">
              {updates.map((u) => (
                <li class="grid grid-cols-[auto_1fr] gap-x-4 border-b border-(--color-rule-soft) py-4">
                  <span
                    class="mt-1.5 h-2.5 w-2.5 shrink-0"
                    style={`background:var(--color-${u.stage ?? c.stage})`}
                  ></span>
                  <div>
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm">
                      <span class="font-medium">{u.author.name}</span>
                      {u.stage && <StageStamp stage={u.stage} class="text-[0.72rem]" />}
                      <span class="text-xs text-(--color-ink-faint)">{ago(u.created_at)}</span>
                    </div>
                    <p class="mt-1.5 leading-relaxed text-(--color-ink-soft)">{u.body}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>

      {people.length > 0 && (
        <aside class="mt-8 lg:mt-0">
          <h2 class="text-[0.72rem] font-semibold uppercase tracking-[0.14em]">People on this</h2>
          <ul class="mt-3 border-t border-(--color-rule-soft)">
            {people.map((p) => (
              <li class="border-b border-(--color-rule-soft) py-2.5">
                <p class="text-sm font-medium">{p.name}</p>
                <p class="text-xs text-(--color-ink-soft)">
                  {p.kinds.map((k) => ACTION_DOING[k]).join(' · ')}
                </p>
                <p class="mt-0.5 text-xs text-(--color-ink-faint)">
                  {p.skills.slice(0, 3).join(' · ')}{p.location && ` · ${p.location}`}
                </p>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </main>
</Base>
