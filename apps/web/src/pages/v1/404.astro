---
import Base from '../../layouts/Base.astro'
import Sheet from '../../components/Sheet.astro'
import FormPage from '../../components/FormPage.astro'
import { getFeed } from '../../lib/api'

/*
 * Without this file the build emits no 404.html, so ASSETS.fetch answered a
 * mistyped or deleted /c/<slug> with its own bare 404 - a completely blank
 * page. The Worker already returns the right status; it had nothing to serve.
 *
 * A miss is still a page of the same document, so it renders inside the Sheet
 * with a way back to the index rather than dead-ending the reader.
 */
const { challenges } = await getFeed('?limit=3')
---
<Base title="Not on this sheet - Techno Optimists" description="That Challenge is not on this sheet." noindex>
  <Sheet>
    <FormPage title="A different path, perhaps?" description="This Challenge may have moved, or the link may be mistyped." icon="compass">
      <a
        href="/v1"
        class="recovery-link mt-8 inline-block border border-(--color-rule) px-4 py-2.5 font-[family-name:var(--font-mono)] text-[0.7rem] uppercase tracking-[0.1em] hover:bg-(--color-ink) hover:text-(--color-paper)"
      >
        Back to the index
      </a>

      {challenges.length > 0 && (
        <section class="mt-12 border-t border-(--color-rule) pt-6">
          <h2 class="font-[family-name:var(--font-mono)] text-[0.68rem] font-bold uppercase tracking-[0.06em]">
            Recently active
          </h2>
          <ul class="mt-3">
            {challenges.map((c) => (
              <li class="border-b border-(--color-rule-soft) py-2.5">
                <a href={`/v1/c/${c.slug}`} class="text-[0.95rem] leading-snug hover:underline">{c.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </FormPage>
  </Sheet>
</Base>
