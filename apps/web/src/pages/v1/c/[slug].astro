---
import Base from '../../../layouts/Base.astro'
import Sheet from '../../../components/Sheet.astro'
import PageToolbar from '../../../components/PageToolbar.astro'
import ChallengeDetail from '../../../components/challenge/ChallengeDetail'
import { getChallenge, getPublicThreads } from '../../../lib/api'
import { threadPageTitle } from '../../../lib/thread-title.mjs'
import '../../../styles/detail.css'
import '../../../styles/discussion.css'
export async function getStaticPaths() {
  const challenges = await getPublicThreads()
  return [...challenges.map(c => ({ params: { slug: c.slug } })), { params: { slug: '_shell' } }]
}
const { slug } = Astro.params
const initial = slug === '_shell' ? undefined : await getChallenge(slug!)
const c = initial?.challenge
---
<Base title={c ? threadPageTitle(c.title) : 'Thread - Techno Optimists'} description={c?.summary} noindex={!c}>
  <Sheet>
    <PageToolbar label="Thread" />
    <main class="challenge-detail"><ChallengeDetail client:load initial={initial} /></main>
  </Sheet>
</Base>
