---
import Base from '../layouts/Base.astro'
import NewspaperShell from '../components/newspaper/NewspaperShell.astro'
import { getFeed } from '../lib/api'
import '../styles/careers.css'

Astro.csp?.insertScriptResource('https://techguyverlabs.org')
Astro.csp?.insertDirective("connect-src 'self' https://techguyverlabs.org")

const { challenges } = await getFeed('?limit=50')
const roles = [
  { href: 'https://techguyverlabs.org/careers/growth-partner-openrobotkits/', title: 'Founding Growth Partner, OpenRobotKits', proof: 'Lead growth for an open-source robotics marketplace', pay: 'Remote · Part time · Equity' },
  { href: 'https://techguyverlabs.org/careers/sales-partner-frontdoor/', title: 'Founding Sales Partner, FrontDoor', proof: 'Lead sales for our web and technology service for local businesses', pay: 'Remote · Part time · Commission' },
]
---
<Base title="Careers - Techno Optimists" description="Work with TechGuyver Labs, the studio behind Techno Optimists. Partner roles on the customer side, founding roles in growth and sales.">
  <NewspaperShell section="Careers" challenges={challenges}>
    <div class="np-careers">
      <h1>Work with us</h1>
      <p class="np-careers-lede">Techno Optimists is built by TechGuyver Labs, a software studio that builds and operates products in AI, robotics and creator tools. We are adding founding partners to lead growth and sales.</p>
      <ul class="np-careers-roles">
        {roles.map((r) => (
          <li>
            <a href={r.href}>
              <h2>{r.title}</h2>
              <p>{r.proof}</p>
              <p>{r.pay}</p>
            </a>
          </li>
        ))}
      </ul>
      <p><a class="np-careers-all" href="https://techguyverlabs.org/careers/">All open roles at TechGuyver Labs</a></p>
      <h2>Apply</h2>
      <div data-tg-apply data-role="General application (Techno Optimists)"><p>Email <a href="mailto:roy@techguyverlabs.org">roy@techguyverlabs.org</a></p></div>
      <script src="https://techguyverlabs.org/careers/apply.js" defer is:inline></script>
    </div>
  </NewspaperShell>
</Base>
