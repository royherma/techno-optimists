---
import '../styles/global.css'
import Snack from '../components/Snack.tsx'
import { ORIGIN, SCHEMA_JSON } from '../lib/schema.mjs'
interface Props { title: string; description?: string; image?: string; noindex?: boolean }
const { title, description = 'Find interesting real-world problems and help solve them.', image = '/og.png', noindex = false } = Astro.props

// The canonical origin. Astro.site is unset (static output, two deploy targets),
// so the prod domain is named here - a relative og:image is ignored by every
// scraper, they all require an absolute URL. It comes from lib/schema.mjs
// because astro.config.mjs needs the same value to hash the JSON-LD.
const canonicalPath = Astro.url.pathname.replace(/^\/v2(?=\/|$)/, '') || '/'
const canonical = new URL(canonicalPath, ORIGIN).href
const ogImage = new URL(image, ORIGIN).href

// Absent in dev and in any build that has not been given the token: the tag is
// then omitted entirely rather than emitted empty, which Search Console reads
// as a failed verification.
const gscToken = import.meta.env.GSC_VERIFICATION ?? process.env.GSC_VERIFICATION ?? ''
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!--
      A canonical on the 404 page tells a crawler the soft-404 is a real,
      indexable URL. Pages that are not addresses get noindex and no canonical.
    -->
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <!--
      Three icon entries, not one: .ico is the only thing some crawlers and
      older browsers look for at all, the 32px PNG is what a modern tab renders,
      and apple-touch-icon is opaque because iOS fills alpha with black.
    -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fafbfc" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Techno Optimists" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!--
      Google Search Console ownership. The token is a build-time env var, not a
      literal, so it is not a secret sitting in the repo and dev builds simply
      omit the tag. Set GSC_VERIFICATION in .dev.vars / the build environment.

      The meta-tag method verifies one origin and has to survive every deploy -
      it does, because this layout wraps every page. The DNS TXT method would
      cover the whole domain, but technooptimists.org resolves through
      Cloudflare (martin/ines.ns.cloudflare.com) and the deploy token holds no
      dns_records scope, so that route is a dashboard click rather than a
      deploy-time guarantee.
    -->
    {gscToken && <meta name="google-site-verification" content={gscToken} />}

    <!--
      Structured data, on indexable pages only - a noindex page claiming to be
      the organisation's home is a contradiction, and the account and profile
      pages are both noindex.

      The bytes come from lib/schema.mjs and are printed verbatim. They must
      stay verbatim: astro.config.mjs hashes that same string into the CSP
      script-src, and the emitted tag has to match it byte for byte or the
      browser drops it. `is:inline` keeps Astro's pipeline from touching it.
    -->
    {!noindex && <script type="application/ld+json" is:inline set:html={SCHEMA_JSON} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Display&display=swap" />
  </head>
  <!--
    The page is the drawing table: faint graph paper, and the sheet laid on top
    of it. The paper is not texture for its own sake - it is what makes the
    sheet read as a sheet, an object with edges, rather than as a page that
    happens to have a border drawn on it.
  -->
  <body class="min-h-screen bg-(--color-table)">
    <slot />
    <!--
      Every page gets the message host, so an island on any of them can say
      what just happened - and so the sign-in redirect has somewhere to land
      whichever page the reader was sent back to.
    -->
    <Snack client:load />
  </body>
</html>

<script>
  import { classicPath, editionPath } from '../lib/edition'
  const url = new URL(location.href)
  const edition = url.searchParams.get('v')
  const isV2 = /^\/v2(?:\/|$)/.test(url.pathname)
  try {
    if (edition === '1') sessionStorage.setItem('design-edition', '1')
    else if (isV2 || edition === '2') sessionStorage.setItem('design-edition', '2')
    if (edition === '1' && isV2) { url.pathname = classicPath(url.pathname); location.replace(url.href) }
    else if (!isV2 && !url.pathname.startsWith('/api/') && (edition === '2' || (edition !== '1' && sessionStorage.getItem('design-edition') === '2'))) {
      url.pathname = editionPath(url.pathname); url.searchParams.delete('v'); location.replace(url.href)
    }
  } catch { if (edition === '2' && !isV2) { url.pathname = editionPath(url.pathname); location.replace(url.href) } }
</script>
