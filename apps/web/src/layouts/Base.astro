---
import '../styles/global.css'
import Snack from '../components/Snack.tsx'
interface Props { title: string; description?: string; image?: string; noindex?: boolean }
const { title, description = 'Find interesting real-world problems and help solve them.', image = '/og.png', noindex = false } = Astro.props

// The canonical origin. Astro.site is unset (static output, two deploy targets),
// so the prod domain is named here - a relative og:image is ignored by every
// scraper, they all require an absolute URL.
const ORIGIN = 'https://technooptimists.org'
const canonical = new URL(Astro.url.pathname, ORIGIN).href
const ogImage = new URL(image, ORIGIN).href

// Absent in dev and in any build that has not been given the token: the tag is
// then omitted entirely rather than emitted empty, which Search Console reads
// as a failed verification.
const gscToken = import.meta.env.GSC_VERIFICATION ?? process.env.GSC_VERIFICATION ?? ''

/*
 * Structured data. Two nodes in one graph rather than two script tags, which is
 * what Google's own examples do and what lets the WebSite reference the
 * Organization by @id instead of repeating it.
 *
 * The Organization carries the legal entity, because the name a search engine
 * shows in a knowledge panel should match the one on the Terms page. No
 * `sameAs` profiles are listed - inventing URLs here would be a fabricated
 * claim, and an absent property costs nothing.
 *
 * SearchAction is deliberately absent: the sitelinks searchbox needs a real
 * query endpoint, and there is no /search route to point it at.
 *
 * It is emitted on indexable pages only. A noindex page telling a crawler it is
 * the organisation's home is a contradiction, and the account and profile pages
 * are both noindex.
 */
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${ORIGIN}/#organization`,
      name: 'Techno Optimists',
      url: ORIGIN,
      logo: new URL('/icon-192.png', ORIGIN).href,
      description:
        'A global community of people using technology to understand real-world problems, try ideas and build better solutions together.',
      parentOrganization: { '@type': 'Organization', name: 'Techguyver Labs, LLC' },
    },
    {
      '@type': 'WebSite',
      '@id': `${ORIGIN}/#website`,
      url: ORIGIN,
      name: 'Techno Optimists',
      description: 'Find interesting real-world problems and help solve them.',
      publisher: { '@id': `${ORIGIN}/#organization` },
      inLanguage: 'en',
    },
  ],
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!--
      A canonical on the 404 page tells a crawler the soft-404 is a real,
      indexable URL. Pages that are not addresses get noindex and no canonical.
    -->
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <!--
      Three icon entries, not one: .ico is the only thing some crawlers and
      older browsers look for at all, the 32px PNG is what a modern tab renders,
      and apple-touch-icon is opaque because iOS fills alpha with black.
    -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fafbfc" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Techno Optimists" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!--
      Google Search Console ownership. The token is a build-time env var, not a
      literal, so it is not a secret sitting in the repo and dev builds simply
      omit the tag. Set GSC_VERIFICATION in .dev.vars / the build environment.

      The meta-tag method verifies one origin and has to survive every deploy -
      it does, because this layout wraps every page. The DNS TXT method would
      cover the whole domain, but technooptimists.org resolves through
      Cloudflare (martin/ines.ns.cloudflare.com) and the deploy token holds no
      dns_records scope, so that route is a dashboard click rather than a
      deploy-time guarantee.
    -->
    {gscToken && <meta name="google-site-verification" content={gscToken} />}

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Display&display=swap" />
  </head>
  <!--
    The page is the drawing table: faint graph paper, and the sheet laid on top
    of it. The paper is not texture for its own sake - it is what makes the
    sheet read as a sheet, an object with edges, rather than as a page that
    happens to have a border drawn on it.
  -->
  <body class="min-h-screen bg-(--color-table)">
    <slot />
    <!--
      Every page gets the message host, so an island on any of them can say
      what just happened - and so the sign-in redirect has somewhere to land
      whichever page the reader was sent back to.
    -->
    <Snack client:load />
  </body>
</html>
